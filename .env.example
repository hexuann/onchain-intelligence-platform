# Set these with export (the binary does not auto-load .env)
DATABASE_URL=postgres://chainindexer:replace_with_secure_password@localhost:5432/chainindexer?sslmode=disable
RPC_URL=https://your-sepolia-json-rpc-provider
CHAIN_ID=11155111
HTTP_ADDR=:8080
ANALYSIS_MAX_DEPTH=3
START_BLOCK=0
END_BLOCK=0
WORKERS=2
RECEIPT_WORKERS=4
CONTINUOUS=true
POLL_INTERVAL_MS=2000
REORG_LOOKBACK=64
